{
 "owner": "consus-launcher/policy/connector-cases.json",
 "spec": "gov_open_router specs/device-policy-models-and-custom-connectors.md",
 "about": "Shared cases for the custom connector rule. The gateway, the launcher and the portal each validate every case's connectors list and must reach the outcome given. The gateway also asserts the reason code (first failure wins); the others may assert only accepted or refused. The launcher repo owns this file; the others carry copies. Change the rule here first, then in all three. NaN, Infinity and unpaired surrogates (\"\\ud800\") are refused too (connector_blob) but cannot be written in a valid JSON file, so each suite tests them itself.",
 "transports": {
  "claude_code": [
   "http"
  ],
  "claude_desktop": [
   "http"
  ]
 },
 "transport_keys": [
  "type",
  "transport"
 ],
 "required_transport_keys": {
  "claude_code": "type"
 },
 "command_keys": [
  "command",
  "args",
  "env",
  "headersHelper"
 ],
 "secret_keys": [
  "headers",
  "clientSecret"
 ],
 "variable_marker": "${",
 "blob_max_bytes": 4096,
 "blob_max_depth": 8,
 "custom_max": 16,
 "connectors_max": 24,
 "url_max": 256,
 "server_key": "server",
